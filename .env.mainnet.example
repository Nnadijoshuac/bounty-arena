# Arc MAINNET. Real USDC. Copy this file to .env.mainnet (gitignored) and fill it in yourself.
# Never commit .env.mainnet. Never paste these keys into a chat or a ticket.

# A wallet you control with a little USDC on Arc mainnet for gas (USDC is the gas token on Arc).
MAINNET_DEPLOYER_KEY=

# The verifier service signs with this key. Fund it with a little USDC too: it pays gas for every check.
MAINNET_VERIFIER_KEY=

# Roles set on the contract at deploy time. Use addresses you control, ideally a multisig for TREASURY.
TREASURY=
ARBITER=
# The address of MAINNET_VERIFIER_KEY
VERIFIER=

# Optional: a dedicated RPC (Alchemy, QuickNode, dRPC, Blockdaemon). Defaults to https://rpc.mainnet.arc.io
ARC_MAINNET_RPC_URL=

# Must read exactly this for the deploy script to run:
CONFIRM_MAINNET=
